{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qqq-strategy-auto-deploy",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  // 分支预览使用本分支的静态资源；不配置生产 Hook Secret 或 Cron。
  "previews": {},
  "observability": {
    "enabled": true
  }
}
